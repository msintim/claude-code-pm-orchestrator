{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "brand", "staging", "pii_policy", "flows"],
  "properties": {
    "version": { "const": 1 },
    "product": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "font", "theme"],
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "font": { "type": "string", "minLength": 1 },
        "theme": { "enum": ["light", "dark"] }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "login": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "user_env", "pass_env", "submit", "settled"],
          "properties": {
            "path": { "type": "string", "pattern": "^/" },
            "user_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "pass_env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
            "submit": { "type": "string", "minLength": 1 },
            "settled": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "hide": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "pii_policy": { "type": "string", "minLength": 1 },
    "redact": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "beats"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "feature": { "type": "string", "minLength": 1 },
          "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "selector": { "type": "string", "minLength": 1 },
    "beat": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "goto": { "type": "string", "minLength": 1 },
        "click": { "$ref": "#/$defs/selector" },
        "fill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "text"],
          "properties": {
            "selector": { "$ref": "#/$defs/selector" },
            "text": { "type": "string" }
          }
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "value"],
          "properties": {
            "selector": { "$ref": "#/$defs/selector" },
            "value": { "type": "string" }
          }
        },
        "hover": { "$ref": "#/$defs/selector" },
        "scroll": { "$ref": "#/$defs/selector" },
        "wait": { "type": "integer", "minimum": 0, "maximum": 3000 },
        "settle": { "$ref": "#/$defs/selector" }
      }
    }
  }
}
